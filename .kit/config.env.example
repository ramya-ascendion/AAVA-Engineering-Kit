# Per-project settings for the engineering kit. Copy to `.kit/config.env`.
# Shell-sourceable (KEY=value, no spaces around "="). Hooks `source` it and
# `tools/kit_config.py` parses the same file, so one edit reaches both.
# Nothing in the kit hardcodes a project name; everything it needs is here.

KIT_PROJECT_NAME="my-project"
# Python package directory the gates measure (layering, coverage, CRAP).
KIT_PACKAGE_DIR="src/my_project"
# Dotted import name of that package.
KIT_PYTHON_PACKAGE="my_project"
# Virtualenv directory, relative to the repo root.
KIT_VENV_DIR=".venv"
# Ticket key prefix used in branches, commits and PR titles (PROJ-123).
KIT_TICKET_PREFIX="PROJ"
# Prefix for skills this project writes itself.
KIT_SKILL_PREFIX="aes"
# Which spelling the word gate enforces: american | none
KIT_SPELLING_LOCALE="american"
# Where tickets live: github | jira | local
KIT_TRACKER="github"
KIT_DEFAULT_BRANCH="main"
# link = skills are links into one real copy (needs symlink rights).
# copy = every skill is real files in all three places and a gate proves them
# byte-identical. Use copy on Windows, or when the repo is pushed and cloned.
KIT_SKILL_LAYOUT="copy"
# yes = refuse a direct commit on a protected branch (hard rule 11).
KIT_PROTECT_BRANCHES="yes"
# Space separated; empty means KIT_DEFAULT_BRANCH.
KIT_PROTECTED_BRANCHES=""
KIT_COVERAGE_BAR="75"
KIT_CRAP_BAR="30"
# Test directories a commit runs, space separated.
KIT_TEST_DIRS="tests/unit"

# Language stack: node | python | none. Python-only gates (black, flake8,
# pylint, mypy, layering, CRAP, import resolution, duplicate code) run only
# when this is "python" and print "NOT RUN (stack is X)" otherwise. Secrets,
# document-structure, skill-mirror and spelling run for every stack.
KIT_STACK="none"
# Command the commit gate runs when a staged path could change a test, from
# the repo root. Empty = NOT RUN "no test command configured", except for
# KIT_STACK=python, where it defaults to: python -m pytest $KIT_TEST_DIRS -q
# Node example: KIT_TEST_CMD="node --test"
KIT_TEST_CMD=""
# Optional extra lint command (whole tree, any stack). Empty = none.
KIT_LINT_CMD=""
