KIT_PROJECT_NAME="AAVA-AES-2.0"
KIT_STACK="node"
KIT_PACKAGE_DIR="server"
KIT_PYTHON_PACKAGE=""
KIT_VENV_DIR=".venv"
# Decided from the repo: commits are conventional (feat/fix/refactor/docs) and carry no
# ticket key, branches are worktree-<slug>, and the tracker is docs/PENDING-BRANCHES.md.
KIT_TICKET_PREFIX="AES"
KIT_SKILL_PREFIX="aes"
# Decided from the repo: the docs mix both spellings (behavior 65, behaviour 55), so the word gate stays off.
KIT_SPELLING_LOCALE="none"
KIT_TRACKER="local"
KIT_DEFAULT_BRANCH="master"
# Real files in all three skill places, so a clone or a viewer needs no symlink rights.
KIT_SKILL_LAYOUT="copy"
# Decided from the repo: its own hooks/pre-commit already forbids direct commits to master.
KIT_PROTECT_BRANCHES="yes"
KIT_PROTECTED_BRANCHES="master"
# Decided from the repo: CI runs `node tools/unit.js`, which itself runs unit-adapters.js and unit-portable.js.
# e2e.js writes to the live AAVA realm, so it is never a commit gate.
KIT_TEST_CMD="node tools/unit.js"
KIT_TEST_DIRS="tools"
