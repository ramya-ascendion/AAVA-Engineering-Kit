KIT_PROJECT_NAME="AAES-3.0"
KIT_STACK="node"
KIT_PACKAGE_DIR="src"
KIT_PYTHON_PACKAGE=""
KIT_VENV_DIR=".venv"
# TODO: confirm the ticket prefix; it is a placeholder, not a decision.
KIT_TICKET_PREFIX="AAES"
KIT_SKILL_PREFIX="aes"
# TODO: decide. "american" turns the word gate on. The existing docs quote British-spelling sources, so it starts off.
KIT_SPELLING_LOCALE="none"
KIT_TRACKER="local"
KIT_DEFAULT_BRANCH="main"
# Real files in all three skill places, so a clone or a viewer needs no symlink rights.
KIT_SKILL_LAYOUT="copy"
# TODO: confirm. Direct commits to the default branch are refused, which suits several sessions in one repo.
KIT_PROTECT_BRANCHES="yes"
KIT_PROTECTED_BRANCHES=""
# TODO: confirm. docs/adr/ADR-004 chooses TypeScript on Node, and no code is verified here yet.
KIT_TEST_CMD=""
KIT_TEST_DIRS="tests"
